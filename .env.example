# Copy to .env and fill in values. .env is gitignored. Never commit, log, or share real values.
# On Vercel, set these in the project's Environment Variables settings instead.

# --- Contentful target (config, so the build can be repointed) ---
# Space ID. Phase 1 finds it from your management token.
CONTENTFUL_SPACE_ID=
# Sandbox environment. Must never be master; scripts refuse master or anything that resolves to it.
CONTENTFUL_ENVIRONMENT_ID=opal-sandbox

# --- Contentful tokens (server side only) ---
# Content Management API personal access token. Used by scripts and the Opal API only.
CONTENTFUL_MANAGEMENT_TOKEN=
# Content Delivery API token (published content) for the front end. Phase 7.
CONTENTFUL_DELIVERY_TOKEN=
# Content Preview API token (draft content) for preview mode. Phase 7.
CONTENTFUL_PREVIEW_TOKEN=

# --- Front end (Phase 7) ---
# Public base URL of the site, used for live and preview links.
SITE_URL=http://localhost:3000
# Long random secret that unlocks draft preview mode.
PREVIEW_SECRET=
# Long random secret the Contentful webhook sends in a header to trigger revalidation.
REVALIDATE_SECRET=

# --- Images (Phase 5): Pixabay API key. Pixabay only accepts it as a URL parameter, so it is used by local scripts only and never logged. ---
PIXABAY_API_KEY=

# --- Opal API (Phase 8) ---
# Authentication for Opal tool calls. Final format depends on what Opal supports.
OPAL_API_TOKEN=
