{
  "name": "opal-contentful-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Contentful sandbox with six fictional brands, a Next.js front end, and an API for Optimizely Opal.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "preflight": "tsx --env-file=.env scripts/preflight.ts",
    "sandbox:create": "tsx --env-file=.env scripts/create-sandbox.ts",
    "sandbox:cleanup": "tsx --env-file=.env scripts/sandbox-cleanup.ts",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "tags:setup": "tsx --env-file=.env scripts/setup-tags.ts",
    "images:search": "tsx --env-file=.env scripts/images/search-candidates.ts",
    "logos:generate": "node scripts/brand-assets/generate-logos.mjs",
    "assets:upload": "tsx --env-file=.env scripts/images/upload-assets.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:check": "tsx scripts/seed.ts --dry-run",
    "verify:funnels": "tsx --env-file=.env scripts/verify-funnels.ts",
    "webhook:setup": "tsx --env-file=.env scripts/setup-webhook.ts"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "16.2.2",
    "@contentful/rich-text-types": "17.2.7",
    "contentful": "11.12.10",
    "contentful-management": "12.19.0",
    "marked": "18.0.14",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "contentful-migration": "5.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "opentype.js": "2.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
